{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cellport.invalid/audio/runtime-manifest-v2.schema.json",
  "title": "CellPort module audio runtime manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "status", "profileId", "device", "kernel", "abi",
    "resources", "loadOrder", "audio", "calibration", "usb",
    "helperCapabilities", "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "status": { "enum": ["candidate", "experimental", "validated"] },
    "profileId": { "$ref": "#/$defs/id" },
    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["vendorId", "productId", "model", "firmwareExact"],
      "properties": {
        "vendorId": { "type": "string", "pattern": "^[A-Fa-f0-9]{4}$" },
        "productId": { "type": "string", "pattern": "^[A-Fa-f0-9]{4}$" },
        "model": { "$ref": "#/$defs/id" },
        "firmwareExact": { "$ref": "#/$defs/id" }
      }
    },
    "kernel": {
      "type": "object", "additionalProperties": false,
      "required": ["release", "buildId", "vermagic", "moduleSymversSha256"],
      "properties": {
        "release": { "$ref": "#/$defs/id" },
        "buildId": { "$ref": "#/$defs/id" },
        "vermagic": { "$ref": "#/$defs/id" },
        "moduleSymversSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "abi": {
      "type": "object", "additionalProperties": false,
      "required": ["architecture", "eabi", "floatAbi", "loader", "libc", "libraries"],
      "properties": {
        "architecture": { "enum": ["armv7", "arm64", "x86_64", "aarch64"] },
        "eabi": { "$ref": "#/$defs/id" },
        "floatAbi": { "enum": ["soft", "softfp", "hard", "not-applicable"] },
        "loader": { "type": "string", "minLength": 1, "maxLength": 256 },
        "libc": { "$ref": "#/$defs/id" },
        "libraries": {
          "type": "array", "items": { "$ref": "#/$defs/library" },
          "uniqueItems": true
        }
      }
    },
    "resources": {
      "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/resource" }
    },
    "loadOrder": {
      "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true
    },
    "audio": {
      "type": "object", "additionalProperties": false,
      "required": ["cardName", "requiredDevices"],
      "properties": {
        "cardName": { "$ref": "#/$defs/id" },
        "requiredDevices": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "pattern": "^/dev/" }, "uniqueItems": true
        }
      }
    },
    "calibration": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "service", "readinessEvidence"],
      "properties": {
        "required": { "type": "boolean" },
        "service": { "$ref": "#/$defs/id" },
        "readinessEvidence": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "usb": {
      "type": "object", "additionalProperties": false,
      "required": ["functionsAllowlist", "transitionOrder"],
      "properties": {
        "functionsAllowlist": {
          "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true
        },
        "transitionOrder": {
          "type": "array", "minItems": 1,
          "items": { "enum": ["disable", "setAudioEnable", "setFunctions", "setEnable", "verify"] }
        }
      }
    },
    "helperCapabilities": {
      "type": "object", "additionalProperties": false,
      "required": [
        "routeOnly", "startWritesFunctions", "startWritesEnable", "startWritesAudioEnable",
        "stopWritesFunctions", "stopWritesEnable", "stopWritesAudioEnable"
      ],
      "properties": {
        "routeOnly": { "type": "boolean" },
        "startWritesFunctions": { "type": "boolean" },
        "startWritesEnable": { "type": "boolean" },
        "startWritesAudioEnable": { "type": "boolean" },
        "stopWritesFunctions": { "type": "boolean" },
        "stopWritesEnable": { "type": "boolean" },
        "stopWritesAudioEnable": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceAudit", "abiAudit", "routeAudit", "calibration", "hardware"],
      "properties": {
        "sourceAudit": { "type": "boolean" },
        "abiAudit": { "type": "boolean" },
        "routeAudit": { "type": "boolean" },
        "calibration": { "type": "boolean" },
        "hardware": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "library": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": { "name": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "kind", "size", "sha256", "mode", "source", "licenseId", "distribution"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
        "kind": { "enum": ["kernelModule", "helper", "vendorLibrary"] },
        "moduleName": { "$ref": "#/$defs/id" },
        "size": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mode": { "type": "integer", "minimum": 0, "maximum": 511 },
        "source": { "$ref": "#/$defs/source" },
        "licenseId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "distribution": { "enum": ["redistributable", "userProvided", "blocked"] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "kernelModule" } }, "required": ["kind"] },
          "then": { "required": ["moduleName"] }
        }
      ]
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "revision", "sourcePath"],
      "properties": {
        "repository": { "type": "string", "format": "uri", "pattern": "^https://" },
        "revision": { "type": "string", "pattern": "^(?:[A-Fa-f0-9]{40}|[A-Fa-f0-9]{64})$" },
        "sourcePath": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
